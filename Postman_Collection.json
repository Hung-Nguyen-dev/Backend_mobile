            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"tripName\": \"HCM Trip 2026\",\n  \"destination\": \"Ho Chi Minh City\",\n  \"startDate\": \"2026-04-05\",\n  \"endDate\": \"2026-04-10\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/v1/trips",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "trips"]
